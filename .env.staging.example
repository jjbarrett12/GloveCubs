# Isolated GloveCubs security staging (copy to .env.staging.local — never commit secrets)
#
# Use with: npm run verify:staging-environment
# Then load for local Express/storefront against the staging Supabase project only.

GC_ENVIRONMENT=staging
GC_ALLOW_DESTRUCTIVE_TESTS=1
GC_EXPECTED_SUPABASE_PROJECT_REF=fmrupehxifzkpfphiyvm
GC_EXPECTED_DEPLOYMENT_HOST=localhost
GC_EMERGENCY_DISABLE_CATALOG_SUPABASE=1
GC_EMAIL_SANDBOX=1

# Staging Supabase (GloveCubs Staging) — NOT GloveCubs V2 (mnmagwsenzvetwngaszv)
SUPABASE_URL=https://fmrupehxifzkpfphiyvm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://fmrupehxifzkpfphiyvm.supabase.co
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local apps targeting staging Auth/DB (nonproduction hosts only)
JWT_SECRET=
STOREFRONT_PUBLIC_ORIGIN=http://localhost:3005
NEXT_PUBLIC_GLOVECUBS_API=http://localhost:3004
API_BASE=http://localhost:3004
DOMAIN=http://localhost:3005

# Leave empty or use a sandbox SMTP host; do not use production SMTP
SMTP_HOST=

# CatalogOS staging-only secret (not production)
CATALOGOS_ADMIN_SECRET=

# Direct Postgres for operator SQL audits / JWT RLS matrix (NEVER commit; NEVER NEXT_PUBLIC_)
# Prefer session/transaction pooler or direct URI from Staging project → Settings → Database.
# Must belong only to project fmrupehxifzkpfphiyvm.
STAGING_DATABASE_URL=
# Optional aliases (also accepted by staging SQL helper; never production URLs):
# SUPABASE_DB_URL=
# DATABASE_URL=

# Explicit opt-in for synthetic fixture writes (default off)
# ALLOW_STAGING_FIXTURE_WRITES=true
